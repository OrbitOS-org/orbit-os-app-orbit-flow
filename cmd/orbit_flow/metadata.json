{
  "name": "Orbit Flow",
  "slug": "orbit-flow",
  "version": "1.0.0",
  "description": "Visual flow editor for industrial automation: Modbus, OPC UA, S7 and MQTT, with the device's own I/O",
  "entry_point": "orbit_flow",
  "permissions": [
    "SystemService/*",
    "AppHubService/*",
    "UartService/*",
    "MobileNotificationService/*",
    "GpioService/*",
    "PwmService/*",
    "I2CService/*",
    "SpiService/*"
  ],
  "package_id": "org.orbit-os.tools.orbit_flow"
}
