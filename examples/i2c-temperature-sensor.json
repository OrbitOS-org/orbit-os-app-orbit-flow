{
  "name": "I²C temperature sensor",
  "description": "Reads a TMP102 or LM75 sensor every 10 s, with a gauge and a chart on the dashboard.",
  "category": "Device",
  "order": 12,
  "needs": "I²C sensor (TMP102 or LM75)",
  "flows": [
    {
      "id": "ex-i2c-temperature-sensor",
      "type": "tab",
      "label": "I²C temperature sensor",
      "info": "Every 10 seconds the I²C Transfer node writes the register number 0x00 to the sensor at address 0x48 and reads 2 bytes back; the Function node turns them into °C. Set the I²C bus of your device in the I²C bus connection, and change the address if your sensor uses another one (0x48 to 0x4B). The temperature also shows on the dashboard (the button with four squares at the top of the editor): a gauge and a chart of the last 6 hours.",
      "nodes": [
        {
          "id": "ex-i2c-temperature-sensor-n1",
          "type": "inject",
          "name": "every 10 s",
          "x": 100,
          "y": 120,
          "z": "ex-i2c-temperature-sensor",
          "inputs": 0,
          "outputs": 1,
          "wires": [
            [
              "ex-i2c-temperature-sensor-n2"
            ]
          ],
          "config": {
            "cron": "",
            "interval": 10000,
            "mode": "interval",
            "once": false,
            "props": [
              {
                "p": "payload",
                "v": "rfc3339",
                "vt": "date"
              }
            ]
          }
        },
        {
          "id": "ex-i2c-temperature-sensor-n2",
          "type": "i2c-transfer",
          "name": "read temperature",
          "x": 310,
          "y": 120,
          "z": "ex-i2c-temperature-sensor",
          "inputs": 1,
          "outputs": 1,
          "wires": [
            [
              "ex-i2c-temperature-sensor-n3"
            ]
          ],
          "config": {
            "address": 72,
            "bus": "ex-i2c-temperature-sensor-c1",
            "readLength": 2,
            "writeData": "00"
          }
        },
        {
          "id": "ex-i2c-temperature-sensor-n3",
          "type": "function",
          "name": "to °C",
          "x": 520,
          "y": 120,
          "z": "ex-i2c-temperature-sensor",
          "inputs": 1,
          "outputs": 1,
          "wires": [
            [
              "ex-i2c-temperature-sensor-n4",
              "ex-i2c-temperature-sensor-n5",
              "ex-i2c-temperature-sensor-n6"
            ]
          ],
          "config": {
            "func": "// TMP102: 12-bit value in the top bits, 0.0625 °C per step\nconst b = msg.payload;\nlet raw = ((b[0] << 8) | b[1]) >> 4;\nif (raw & 0x800) raw -= 4096;\nmsg.payload = raw * 0.0625;\nreturn msg;",
            "outputs": 1
          }
        },
        {
          "id": "ex-i2c-temperature-sensor-n4",
          "type": "debug",
          "name": "temperature °C",
          "x": 720,
          "y": 120,
          "z": "ex-i2c-temperature-sensor",
          "inputs": 1,
          "outputs": 0,
          "wires": [],
          "config": {
            "active": true,
            "output": "property",
            "property": "payload",
            "statusEnabled": false,
            "statusOutput": "same",
            "statusProperty": ""
          }
        },
        {
          "id": "ex-i2c-temperature-sensor-n5",
          "type": "ui-gauge",
          "name": "Temperature",
          "x": 720,
          "y": 200,
          "z": "ex-i2c-temperature-sensor",
          "inputs": 1,
          "outputs": 0,
          "wires": [],
          "config": {
            "group": "ex-i2c-temperature-sensor-g1",
            "order": 1,
            "width": 4,
            "min": -10,
            "max": 50,
            "units": "°C"
          }
        },
        {
          "id": "ex-i2c-temperature-sensor-n6",
          "type": "ui-chart",
          "name": "Last 6 hours",
          "x": 720,
          "y": 260,
          "z": "ex-i2c-temperature-sensor",
          "inputs": 1,
          "outputs": 0,
          "wires": [],
          "config": {
            "group": "ex-i2c-temperature-sensor-g1",
            "order": 2,
            "width": 8,
            "chartType": "line",
            "units": "°C",
            "removeOlder": 6,
            "removeOlderUnit": "3600",
            "removeOlderPoints": 3000
          }
        }
      ],
      "wires": [
        {
          "id": "ex-i2c-temperature-sensor-n1-w0--n2",
          "sourceNode": "ex-i2c-temperature-sensor-n1",
          "sourcePort": 0,
          "targetNode": "ex-i2c-temperature-sensor-n2",
          "targetPort": 0
        },
        {
          "id": "ex-i2c-temperature-sensor-n2-w0--n3",
          "sourceNode": "ex-i2c-temperature-sensor-n2",
          "sourcePort": 0,
          "targetNode": "ex-i2c-temperature-sensor-n3",
          "targetPort": 0
        },
        {
          "id": "ex-i2c-temperature-sensor-n3-w0--n4",
          "sourceNode": "ex-i2c-temperature-sensor-n3",
          "sourcePort": 0,
          "targetNode": "ex-i2c-temperature-sensor-n4",
          "targetPort": 0
        },
        {
          "id": "ex-i2c-temperature-sensor-n3-w0--n5",
          "sourceNode": "ex-i2c-temperature-sensor-n3",
          "sourcePort": 0,
          "targetNode": "ex-i2c-temperature-sensor-n5",
          "targetPort": 0
        },
        {
          "id": "ex-i2c-temperature-sensor-n3-w0--n6",
          "sourceNode": "ex-i2c-temperature-sensor-n3",
          "sourcePort": 0,
          "targetNode": "ex-i2c-temperature-sensor-n6",
          "targetPort": 0
        }
      ]
    }
  ],
  "configs": [
    {
      "id": "ex-i2c-temperature-sensor-c1",
      "type": "i2c-bus",
      "name": "I²C bus 1",
      "config": {
        "bus": 1,
        "clockHz": 100000,
        "clockStretching": false,
        "name": "I²C bus 1",
        "tenBitAddr": false
      }
    },
    {
      "id": "ex-i2c-temperature-sensor-p1",
      "type": "ui-page",
      "name": "Temperature",
      "config": {
        "order": 1
      }
    },
    {
      "id": "ex-i2c-temperature-sensor-g1",
      "type": "ui-group",
      "name": "Sensor",
      "config": {
        "page": "ex-i2c-temperature-sensor-p1",
        "width": 12,
        "order": 1
      }
    }
  ]
}
