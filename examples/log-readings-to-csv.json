{
  "name": "Log readings to CSV",
  "description": "Writes readings to one CSV file per day in the app's files.",
  "category": "Data",
  "order": 22,
  "flows": [
    {
      "id": "ex-log-readings-to-csv",
      "type": "tab",
      "label": "Log readings to CSV",
      "info": "Every 10 seconds a reading (simulated here) goes through the CSV node, which turns it into a CSV line, and Write File adds it to logs/readings-YYYY-MM-DD.csv in the app's files, one file per day. The Function sets msg.reset on the first reading of each day, so the CSV node writes the column names at the top of the new file. Replace the Function with your real readings. See the files in Settings → Files, or read them back with Read File.",
      "nodes": [
        {
          "id": "ex-log-readings-to-csv-n1",
          "type": "inject",
          "name": "every 10 s",
          "x": 100,
          "y": 120,
          "z": "ex-log-readings-to-csv",
          "inputs": 0,
          "outputs": 1,
          "wires": [
            [
              "ex-log-readings-to-csv-n2"
            ]
          ],
          "config": {
            "cron": "",
            "interval": 10000,
            "mode": "interval",
            "once": false,
            "props": [
              {
                "p": "payload",
                "v": "rfc3339",
                "vt": "date"
              }
            ]
          }
        },
        {
          "id": "ex-log-readings-to-csv-n2",
          "type": "function",
          "name": "reading",
          "x": 300,
          "y": 120,
          "z": "ex-log-readings-to-csv",
          "inputs": 1,
          "outputs": 1,
          "wires": [
            [
              "ex-log-readings-to-csv-n3"
            ]
          ],
          "config": {
            "func": "const now = new Date();\nmsg.day = now.toISOString().slice(0, 10);\n// A new day starts a new file: msg.reset makes the CSV node send the column names again.\nif (context.get('day') !== msg.day) {\n  msg.reset = true;\n  context.set('day', msg.day);\n}\nmsg.payload = {\n  time: now.toISOString(),\n  temperature: Math.round((20 + Math.random() * 5) * 10) / 10,\n  humidity: Math.round(40 + Math.random() * 20),\n};\nreturn msg;",
            "outputs": 1
          }
        },
        {
          "id": "ex-log-readings-to-csv-n3",
          "type": "csv",
          "name": "to CSV",
          "x": 520,
          "y": 120,
          "z": "ex-log-readings-to-csv",
          "inputs": 1,
          "outputs": 1,
          "wires": [
            [
              "ex-log-readings-to-csv-n5"
            ]
          ],
          "config": {
            "property": "payload",
            "action": "stringify",
            "header": true,
            "headerOnce": true,
            "columns": "time,temperature,humidity",
            "delimiter": ",",
            "quoteChar": "\"",
            "comment": "",
            "trimSpaces": false,
            "skipEmptyLines": true,
            "forceQuote": false,
            "newline": "\n",
            "output": "rows",
            "cast": false
          }
        },
        {
          "id": "ex-log-readings-to-csv-n5",
          "type": "file-out",
          "name": "logs/readings-<day>.csv",
          "x": 730,
          "y": 120,
          "z": "ex-log-readings-to-csv",
          "inputs": 1,
          "outputs": 1,
          "wires": [
            [
              "ex-log-readings-to-csv-n4"
            ]
          ],
          "config": {
            "path": "logs/readings-{{day}}.csv",
            "mode": "append",
            "appendNewline": false
          }
        },
        {
          "id": "ex-log-readings-to-csv-n4",
          "type": "debug",
          "name": "written",
          "x": 940,
          "y": 120,
          "z": "ex-log-readings-to-csv",
          "inputs": 1,
          "outputs": 0,
          "wires": [],
          "config": {
            "active": true,
            "output": "property",
            "property": "payload",
            "statusEnabled": false,
            "statusOutput": "same",
            "statusProperty": ""
          }
        }
      ],
      "wires": [
        {
          "id": "ex-log-readings-to-csv-n1-w0--n2",
          "sourceNode": "ex-log-readings-to-csv-n1",
          "sourcePort": 0,
          "targetNode": "ex-log-readings-to-csv-n2",
          "targetPort": 0
        },
        {
          "id": "ex-log-readings-to-csv-n2-w0--n3",
          "sourceNode": "ex-log-readings-to-csv-n2",
          "sourcePort": 0,
          "targetNode": "ex-log-readings-to-csv-n3",
          "targetPort": 0
        },
        {
          "id": "ex-log-readings-to-csv-n3-w0--n5",
          "sourceNode": "ex-log-readings-to-csv-n3",
          "sourcePort": 0,
          "targetNode": "ex-log-readings-to-csv-n5",
          "targetPort": 0
        },
        {
          "id": "ex-log-readings-to-csv-n5-w0--n4",
          "sourceNode": "ex-log-readings-to-csv-n5",
          "sourcePort": 0,
          "targetNode": "ex-log-readings-to-csv-n4",
          "targetPort": 0
        }
      ]
    }
  ],
  "configs": []
}
