            "scale": 1,
            "server": "ex-energy-meter-c1",
            "unitId": 1,
            "wordOrder": "bigEndian",
            "topicTemplate": "power"
          }
        },
        {
          "id": "ex-energy-meter-n5",
          "type": "debug",
          "name": "meter",
          "x": 600,
          "y": 160,
          "z": "ex-energy-meter",
          "inputs": 1,
          "outputs": 0,
          "wires": [],
          "config": {
            "active": true,
            "output": "property",
            "property": "payload",
            "statusEnabled": false,
            "statusOutput": "same",
            "statusProperty": ""
          }
        },
        {
          "id": "ex-energy-meter-n6",
          "type": "function",
          "name": "for the dashboard",
          "x": 600,
          "y": 260,
          "z": "ex-energy-meter",
          "inputs": 1,
          "outputs": 3,
          "wires": [
            [
              "ex-energy-meter-n7",
              "ex-energy-meter-n10"
            ],
            [
              "ex-energy-meter-n8"
            ],
            [
              "ex-energy-meter-n9"
            ]
          ],
          "config": {
            "func": "// The joined reading has one key per register (topic modbus/<meter>/<address>).\nconst p = msg.payload;\nconst at = a => Object.entries(p).find(([k]) => k.endsWith('/' + a))?.[1];\nreturn [\n  { topic: 'power W', payload: at(12) },\n  { payload: at(0) },\n  { payload: at(6) },\n];",
            "outputs": 3
          }
        },
