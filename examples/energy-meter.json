            "scale": 1,
            "server": "ex-energy-meter-c1",
            "unitId": 1,
            "wordOrder": "bigEndian",
            "topicTemplate": "power"
          }
        },
        {
          "id": "ex-energy-meter-n5",
          "type": "debug",
          "name": "meter",
          "x": 600,
          "y": 160,
          "z": "ex-energy-meter",
          "inputs": 1,
          "outputs": 0,
          "wires": [],
          "config": {
            "active": true,
