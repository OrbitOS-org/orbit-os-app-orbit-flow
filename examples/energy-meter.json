  ],
  "configs": [
    {
      "id": "ex-energy-meter-c1",
      "type": "modbus-server",
      "name": "RS-485 · energy meter",
      "config": {
        "baudRate": 9600,
        "dataBits": 8,
        "defaultUnitId": 1,
        "host": "localhost",
        "idleTimeout": 60,
        "parity": "none",
        "port": 502,
        "reconnectBackoff": 5,
        "serialPort": "ttyS1",
        "stopBits": 1,
        "timeout": 1000,
        "transport": "rtu"
      }
