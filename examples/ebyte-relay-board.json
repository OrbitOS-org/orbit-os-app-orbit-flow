        {
          "id": "er-chase-onoff",
          "type": "function",
          "name": "chase on/off",
          "x": 330,
          "y": 580,
          "z": "ebyte-relays",
          "inputs": 1,
          "outputs": 1,
          "wires": [
            [
              "er-writeall"
            ]
          ],
          "config": {
            "func": "// Start / Stop the relay chase. Stop also switches all 4 relays off.\nflow.set('chase', msg.payload === true);\nif (msg.payload === true) {\n  node.status('green', 'running');\n  return null; // the next tick switches relay 1 on\n}\nnode.status('grey', 'stopped');\nmsg.payload = [false, false, false, false];\nreturn msg;",
            "outputs": 1
          }
        },
        {
          "id": "er-chase-tick",
          "type": "inject",
          "name": "every 1 s",
          "x": 80,
          "y": 660,
          "z": "ebyte-relays",
          "inputs": 0,
          "outputs": 1,
          "wires": [
            [
              "er-chase-next"
            ]
          ],
          "config": {
            "cron": "",
            "interval": 1000,
            "mode": "interval",
            "once": false,
            "props": [
              {
                "p": "payload",
                "v": "rfc3339",
                "vt": "date"
              }
            ]
          }
        },
        {
          "id": "er-chase-next",
          "type": "function",
          "name": "next relay",
          "x": 330,
          "y": 660,
          "z": "ebyte-relays",
          "inputs": 1,
          "outputs": 1,
          "wires": [
            [
              "er-writeall"
            ]
          ],
          "config": {
            "func": "// One step of the chase on each tick: only the next relay is on (1, 2, 3, 4, 1…).\nif (flow.get('chase') !== true) return null;\nconst prev = context.get('step');\nconst step = prev === undefined ? 0 : (prev + 1) % 4;\ncontext.set('step', step);\nmsg.payload = [0, 1, 2, 3].map(i => i === step);\nnode.status('blue', 'relay ' + (step + 1));\nreturn msg;",
            "outputs": 1
          }
        }
