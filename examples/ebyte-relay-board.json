        "dataBits": 8,
        "defaultUnitId": 32,
        "host": "localhost",
        "idleTimeout": 60,
        "parity": "none",
        "port": 502,
        "reconnectBackoff": 5,
        "serialPort": "ttyS2",
        "stopBits": 1,
        "timeout": 1000,
        "transport": "rtu"
      }
    }
