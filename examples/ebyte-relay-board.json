          "x": 80,
          "y": 600,
          "z": "ebyte-relays",
          "inputs": 0,
          "outputs": 1,
          "wires": [
            [
              "er-chase-onoff"
            ]
          ],
          "config": {
            "cron": "",
            "interval": 0,
            "mode": "interval",
