      ],
      "info": "Controls an EBYTE MA01-AXCX4040 board (4 digital inputs, 4 relays) over Modbus RTU on RS-485. Press the button next to an inject node to switch a relay on or off (function 5, coils 0 to 3) or all four at once (function 15). \"Start relay chase\" switches the relays on one after the other, one per second (1, 2, 3, 4, 1…); \"Stop relay chase\" stops and switches them all off; change the time in \"every 1 s\". The relay state is read every 5 s (function 1) and the inputs every 30 s (function 2). Before deploying, set the serial port, baud rate and unit ID of the board in the Modbus connection."
    }
  ],
  "configs": [
    {
      "id": "ebyte-rs485",
      "type": "modbus-server",
      "name": "RS-485 #2 (ttyS2) · EBYTE 4DI+4DO · unit 32",
      "config": {
        "baudRate": 115200,
        "dataBits": 8,
        "defaultUnitId": 32,
        "host": "localhost",
        "idleTimeout": 60,
        "parity": "none",
        "port": 502,
        "reconnectBackoff": 5,
        "serialPort": "ttyS2",
        "stopBits": 1,
        "timeout": 1000,
        "transport": "rtu"
      }
    }
  ]
}
