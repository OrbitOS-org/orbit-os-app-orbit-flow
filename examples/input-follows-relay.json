{
  "name": "Input follows relay",
  "description": "When input 1 of an EBYTE board turns on, relay 1 turns on.",
  "category": "Industrial",
  "order": 11,
  "needs": "EBYTE board, RS-485",
  "flows": [
    {
      "id": "ex-input-follows-relay",
      "type": "tab",
      "label": "Input follows relay",
      "info": "The inputs of an EBYTE MA01-AXCX4040 board are read every second and a message goes out only when they change. Relay 1 then follows input 1, with no computer in between. Set the serial port, baud rate and unit ID of your board in the Modbus connection.",
      "nodes": [
        {
          "id": "ex-input-follows-relay-n1",
          "type": "modbus-read",
          "name": "inputs DI1–DI4",
          "x": 100,
          "y": 120,
          "z": "ex-input-follows-relay",
          "inputs": 0,
          "outputs": 1,
          "wires": [
            [
              "ex-input-follows-relay-n2"
            ]
          ],
          "config": {
            "address": 0,
            "byteOrder": "bigEndian",
            "dataType": "raw",
            "emitOnChange": true,
            "emitOnError": true,
            "fc": 2,
            "mode": "static",
            "offset": 0,
            "pollInterval": 1000,
            "quantity": 4,
            "scale": 1,
            "server": "ex-input-follows-relay-c1",
            "unitId": 32,
            "wordOrder": "bigEndian"
          }
        },
        {
          "id": "ex-input-follows-relay-n2",
          "type": "function",
          "name": "input 1",
          "x": 320,
          "y": 120,
          "z": "ex-input-follows-relay",
          "inputs": 1,
          "outputs": 1,
          "wires": [
            [
              "ex-input-follows-relay-n3",
              "ex-input-follows-relay-n4"
            ]
          ],
          "config": {
            "func": "msg.payload = Boolean(msg.payload[0]);\nreturn msg;",
            "outputs": 1
          }
        },
        {
          "id": "ex-input-follows-relay-n3",
          "type": "modbus-write",
          "name": "relay 1 (coil 0)",
          "x": 520,
          "y": 120,
          "z": "ex-input-follows-relay",
          "inputs": 1,
          "outputs": 0,
          "wires": [],
          "config": {
            "address": 0,
            "byteOrder": "bigEndian",
            "dataType": "raw",
            "emitAck": false,
            "fc": 5,
            "offset": 0,
            "scale": 1,
            "server": "ex-input-follows-relay-c1",
            "unitId": 32,
            "wordOrder": "bigEndian"
          }
        },
        {
          "id": "ex-input-follows-relay-n4",
          "type": "debug",
          "name": "input 1",
          "x": 520,
          "y": 200,
          "z": "ex-input-follows-relay",
          "inputs": 1,
          "outputs": 0,
          "wires": [],
          "config": {
            "active": true,
            "output": "property",
            "property": "payload",
            "statusEnabled": false,
            "statusOutput": "same",
            "statusProperty": ""
          }
        }
      ],
      "wires": [
        {
          "id": "ex-input-follows-relay-n1-w0--n2",
          "sourceNode": "ex-input-follows-relay-n1",
          "sourcePort": 0,
          "targetNode": "ex-input-follows-relay-n2",
          "targetPort": 0
        },
        {
          "id": "ex-input-follows-relay-n2-w0--n3",
          "sourceNode": "ex-input-follows-relay-n2",
          "sourcePort": 0,
          "targetNode": "ex-input-follows-relay-n3",
          "targetPort": 0
        },
        {
          "id": "ex-input-follows-relay-n2-w0--n4",
          "sourceNode": "ex-input-follows-relay-n2",
          "sourcePort": 0,
          "targetNode": "ex-input-follows-relay-n4",
          "targetPort": 0
        }
      ]
    }
  ],
  "configs": [
    {
      "id": "ex-input-follows-relay-c1",
      "type": "modbus-server",
      "name": "RS-485 #2 (ttyS2) · EBYTE 4DI+4DO · unit 32",
      "config": {
        "baudRate": 115200,
        "dataBits": 8,
        "defaultUnitId": 32,
        "host": "localhost",
        "idleTimeout": 60,
        "parity": "none",
        "port": 502,
        "reconnectBackoff": 5,
        "serialPort": "ttyS2",
        "stopBits": 1,
        "timeout": 1000,
        "transport": "rtu"
      }
    }
  ]
}
