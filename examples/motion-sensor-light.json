{
  "name": "Motion sensor light",
  "description": "A motion sensor turns a light on for 60 s and sends a notification to your phone.",
  "category": "Device",
  "order": 11,
  "needs": "Motion sensor and relay module on GPIO pins, Orbit OS mobile app",
  "flows": [
    {
      "id": "ex-motion-sensor-light",
      "type": "tab",
      "label": "Motion sensor light",
      "info": "The motion sensor (for example a PIR sensor) is read on a GPIO pin 4 times a second. When it sees motion and the light is off, the relay on another GPIO pin turns the light on and a notification goes to your phone through the Orbit OS mobile app. The light stays on while there is motion and goes off 60 s after the last one; change ON_FOR_MS in the Function for another time. Set the chip and line of the sensor and of the relay in the two GPIO pin connections (lines 17 and 22 here).",
      "nodes": [
        {
          "id": "ex-motion-sensor-light-n1",
          "type": "inject",
          "name": "every 250 ms",
          "x": 100,
          "y": 140,
          "z": "ex-motion-sensor-light",
          "inputs": 0,
          "outputs": 1,
          "wires": [
            [
              "ex-motion-sensor-light-n2"
            ]
          ],
          "config": {
            "cron": "",
            "interval": 250,
            "mode": "interval",
            "once": false,
            "props": [
              {
                "p": "payload",
                "v": "rfc3339",
                "vt": "date"
              }
            ]
          }
        },
        {
          "id": "ex-motion-sensor-light-n2",
          "type": "gpio-read",
          "name": "motion sensor",
          "x": 320,
          "y": 140,
          "z": "ex-motion-sensor-light",
          "inputs": 1,
          "outputs": 1,
          "wires": [
            [
              "ex-motion-sensor-light-n3"
            ]
          ],
          "config": {
            "pin": "ex-motion-sensor-light-c1"
          }
        },
        {
          "id": "ex-motion-sensor-light-n3",
          "type": "function",
          "name": "light for 60 s",
          "x": 540,
          "y": 140,
          "z": "ex-motion-sensor-light",
          "inputs": 1,
          "outputs": 2,
          "wires": [
            [
              "ex-motion-sensor-light-n4",
              "ex-motion-sensor-light-n6"
            ],
            [
              "ex-motion-sensor-light-n5"
            ]
          ],
          "config": {
            "func": "// Motion turns the light on; it goes off 60 s after the last motion.\n// Output 1: the relay (true/false, only when it changes). Output 2: the notification.\nconst ON_FOR_MS = 60000;\nconst now = Date.now();\nconst motion = msg.payload === true;\nconst lightOn = context.get('on') === true;\nif (motion) context.set('lastMotion', now);\nif (motion && !lightOn) {\n  context.set('on', true);\n  node.status('green', 'light on');\n  return [{ payload: true }, { payload: 'Motion detected: the light is on' }];\n}\nif (!motion && lightOn && now - (context.get('lastMotion') || 0) > ON_FOR_MS) {\n  context.set('on', false);\n  node.status('grey', 'light off');\n  return [{ payload: false }, null];\n}\nreturn null;",
            "outputs": 2
          }
        },
        {
          "id": "ex-motion-sensor-light-n4",
          "type": "gpio-write",
          "name": "light (relay)",
          "x": 780,
          "y": 100,
          "z": "ex-motion-sensor-light",
          "inputs": 1,
          "outputs": 1,
          "wires": [
            []
          ],
          "config": {
            "action": "payload",
            "pin": "ex-motion-sensor-light-c2"
          }
        },
        {
          "id": "ex-motion-sensor-light-n5",
          "type": "mobile-notify",
          "name": "notify my phone",
          "x": 780,
          "y": 200,
          "z": "ex-motion-sensor-light",
          "inputs": 1,
          "outputs": 1,
          "wires": [
            []
          ],
          "config": {
            "body": "",
            "collapseKey": "motion",
            "imageUrl": "",
            "ttlSeconds": 0
          }
        },
        {
          "id": "ex-motion-sensor-light-n6",
          "type": "debug",
          "name": "light",
          "x": 1000,
          "y": 100,
          "z": "ex-motion-sensor-light",
          "inputs": 1,
          "outputs": 0,
          "wires": [],
          "config": {
            "active": true,
            "output": "property",
            "property": "payload",
            "statusEnabled": false,
            "statusOutput": "same",
            "statusProperty": ""
          }
        }
      ],
      "wires": [
        {
          "id": "ex-motion-sensor-light-n1-w0--n2",
          "sourceNode": "ex-motion-sensor-light-n1",
          "sourcePort": 0,
          "targetNode": "ex-motion-sensor-light-n2",
          "targetPort": 0
        },
        {
          "id": "ex-motion-sensor-light-n2-w0--n3",
          "sourceNode": "ex-motion-sensor-light-n2",
          "sourcePort": 0,
          "targetNode": "ex-motion-sensor-light-n3",
          "targetPort": 0
        },
        {
          "id": "ex-motion-sensor-light-n3-w0--n4",
          "sourceNode": "ex-motion-sensor-light-n3",
          "sourcePort": 0,
          "targetNode": "ex-motion-sensor-light-n4",
          "targetPort": 0
        },
        {
          "id": "ex-motion-sensor-light-n3-w0--n6",
          "sourceNode": "ex-motion-sensor-light-n3",
          "sourcePort": 0,
          "targetNode": "ex-motion-sensor-light-n6",
          "targetPort": 0
        },
        {
          "id": "ex-motion-sensor-light-n3-w1--n5",
          "sourceNode": "ex-motion-sensor-light-n3",
          "sourcePort": 1,
          "targetNode": "ex-motion-sensor-light-n5",
          "targetPort": 0
        }
      ]
    }
  ],
  "configs": [
    {
      "id": "ex-motion-sensor-light-c1",
      "type": "gpio-pin",
      "name": "Motion sensor (GPIO 17)",
      "config": {
        "chip": 0,
        "direction": "input",
        "line": 17,
        "name": ""
      }
    },
    {
      "id": "ex-motion-sensor-light-c2",
      "type": "gpio-pin",
      "name": "Light relay (GPIO 22)",
      "config": {
        "chip": 0,
        "direction": "output",
        "line": 22,
        "name": ""
      }
    }
  ]
}
