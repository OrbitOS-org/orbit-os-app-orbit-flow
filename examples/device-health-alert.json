      "config": {
        "page": "ex-device-health-alert-p1",
        "width": 12,
        "order": 1
      }
    },
    {
      "id": "ex-device-health-alert-g2",
      "type": "ui-group",
      "name": "Last hour",
      "config": {
        "page": "ex-device-health-alert-p1",
        "width": 12,
        "order": 2
      }
    }
  ]
}
