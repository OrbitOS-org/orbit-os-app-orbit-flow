{
  "name": "EBYTE inputs log to CSV",
  "description": "Records every change of the 4 inputs of the EBYTE board in a CSV file per day.",
  "category": "Industrial",
  "order": 16,
  "needs": "EBYTE board, RS-485",
  "flows": [
    {
      "id": "ex-ebyte-inputs-log-to-csv",
      "type": "tab",
      "label": "EBYTE inputs log to CSV",
      "info": "The Modbus Read node reads the 4 digital inputs DI1 to DI4 of the EBYTE board every second and, with \"emit on change\", sends the state at start and then only when an input changes. The Function turns it into one row (time and 1/0 per input), the CSV node makes it a CSV line, and Write File adds it to logs/inputs-YYYY-MM-DD.csv in the app's files, so the file is a record of every change. On the first row of each day the Function sets msg.reset, so the new file starts with the column names. It uses the same connection as the \"EBYTE relay board\" example (RS-485 #2, ttyS2, unit 32): imported next to it, both flows share that connection. See and download the files in Settings → Files.",
      "nodes": [
        {
          "id": "ex-ebyte-inputs-log-to-csv-n1",
          "type": "modbus-read",
          "name": "Inputs DI1–DI4 (on change)",
          "x": 120,
          "y": 140,
          "z": "ex-ebyte-inputs-log-to-csv",
          "inputs": 1,
          "outputs": 1,
          "wires": [
            [
              "ex-ebyte-inputs-log-to-csv-n2"
            ]
          ],
          "config": {
            "address": 0,
            "byteOrder": "bigEndian",
            "dataType": "raw",
            "emitOnChange": true,
            "emitOnError": true,
            "fc": 2,
            "mode": "static",
            "offset": 0,
            "pollInterval": 1000,
            "quantity": 4,
            "scale": 1,
            "server": "ex-ebyte-inputs-log-to-csv-c1",
            "unitId": 32,
            "wordOrder": "bigEndian"
          }
        },
        {
          "id": "ex-ebyte-inputs-log-to-csv-n2",
          "type": "function",
          "name": "to a row",
          "x": 340,
          "y": 140,
          "z": "ex-ebyte-inputs-log-to-csv",
          "inputs": 1,
          "outputs": 1,
          "wires": [
            [
              "ex-ebyte-inputs-log-to-csv-n3"
            ]
          ],
          "config": {
            "func": "const now = new Date();\nmsg.day = now.toISOString().slice(0, 10);\n// A new day starts a new file: msg.reset makes the CSV node write the column names again.\nif (context.get('day') !== msg.day) {\n  msg.reset = true;\n  context.set('day', msg.day);\n}\n// msg.payload is the state of the 4 inputs: [true, false, false, true]\nconst di = msg.payload;\nmsg.payload = {\n  time: now.toISOString(),\n  di1: di[0] ? 1 : 0,\n  di2: di[1] ? 1 : 0,\n  di3: di[2] ? 1 : 0,\n  di4: di[3] ? 1 : 0,\n};\nreturn msg;",
            "outputs": 1
          }
        },
        {
          "id": "ex-ebyte-inputs-log-to-csv-n3",
          "type": "csv",
          "name": "to CSV",
          "x": 540,
          "y": 140,
          "z": "ex-ebyte-inputs-log-to-csv",
          "inputs": 1,
          "outputs": 1,
          "wires": [
            [
              "ex-ebyte-inputs-log-to-csv-n4"
            ]
          ],
          "config": {
            "property": "payload",
            "action": "stringify",
            "header": true,
            "headerOnce": true,
            "columns": "time,di1,di2,di3,di4",
            "delimiter": ",",
            "quoteChar": "\"",
            "comment": "",
            "trimSpaces": false,
            "skipEmptyLines": true,
            "forceQuote": false,
            "newline": "\n",
            "output": "rows",
            "cast": false
          }
        },
        {
          "id": "ex-ebyte-inputs-log-to-csv-n4",
          "type": "file-out",
          "name": "logs/inputs-<day>.csv",
          "x": 760,
          "y": 140,
          "z": "ex-ebyte-inputs-log-to-csv",
          "inputs": 1,
          "outputs": 1,
          "wires": [
            [
              "ex-ebyte-inputs-log-to-csv-n5"
            ]
          ],
          "config": {
            "path": "logs/inputs-{{day}}.csv",
            "mode": "append",
            "appendNewline": false
          }
        },
        {
          "id": "ex-ebyte-inputs-log-to-csv-n5",
          "type": "debug",
          "name": "written",
          "x": 980,
          "y": 140,
          "z": "ex-ebyte-inputs-log-to-csv",
          "inputs": 1,
          "outputs": 0,
          "wires": [],
          "config": {
            "active": true,
            "output": "property",
            "property": "payload",
            "statusEnabled": false,
            "statusOutput": "same",
            "statusProperty": ""
          }
        }
      ],
      "wires": [
        {
          "id": "ex-ebyte-inputs-log-to-csv-n1-w0--n2",
          "sourceNode": "ex-ebyte-inputs-log-to-csv-n1",
          "sourcePort": 0,
          "targetNode": "ex-ebyte-inputs-log-to-csv-n2",
          "targetPort": 0
        },
        {
          "id": "ex-ebyte-inputs-log-to-csv-n2-w0--n3",
          "sourceNode": "ex-ebyte-inputs-log-to-csv-n2",
          "sourcePort": 0,
          "targetNode": "ex-ebyte-inputs-log-to-csv-n3",
          "targetPort": 0
        },
        {
          "id": "ex-ebyte-inputs-log-to-csv-n3-w0--n4",
          "sourceNode": "ex-ebyte-inputs-log-to-csv-n3",
          "sourcePort": 0,
          "targetNode": "ex-ebyte-inputs-log-to-csv-n4",
          "targetPort": 0
        },
        {
          "id": "ex-ebyte-inputs-log-to-csv-n4-w0--n5",
          "sourceNode": "ex-ebyte-inputs-log-to-csv-n4",
          "sourcePort": 0,
          "targetNode": "ex-ebyte-inputs-log-to-csv-n5",
          "targetPort": 0
        }
      ]
    }
  ],
  "configs": [
    {
      "id": "ex-ebyte-inputs-log-to-csv-c1",
      "type": "modbus-server",
      "name": "RS-485 #2 (ttyS2) · EBYTE 4DI+4DO · unit 32",
      "config": {
        "baudRate": 115200,
        "dataBits": 8,
        "defaultUnitId": 32,
        "host": "localhost",
        "idleTimeout": 60,
        "parity": "none",
        "port": 502,
        "reconnectBackoff": 5,
        "serialPort": "ttyS2",
        "stopBits": 1,
        "timeout": 1000,
        "transport": "rtu"
      }
    }
  ]
}
