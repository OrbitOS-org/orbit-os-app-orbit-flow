        "timeout": 1000,
        "transport": "tcp"
      }
    },
    {
      "id": "ex-solar-surplus-to-load-c2",
      "type": "modbus-server",
      "name": "RS-485 #2 (ttyS2) · EBYTE 4DI+4DO · unit 32",
      "config": {
        "baudRate": 115200,
        "dataBits": 8,
        "defaultUnitId": 32,
        "host": "localhost",
        "idleTimeout": 60,
        "parity": "none",
        "port": 502,
        "reconnectBackoff": 5,
        "serialPort": "ttyS2",
        "stopBits": 1,
        "timeout": 1000,
        "transport": "rtu"
      }
    }
  ]
}
